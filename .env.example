# ============================================================
# duty-bot 环境配置（真值不进 git：本地 .env 是部署源头，每次 push 覆盖 NAS）
# ============================================================

PORT=3006

# 飞书应用配置（与所有 qianli 项目共用同一个应用）
APP_ID=cli_xxxxxxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 值日多维表格（M0：npm run table:create 自动建表，或手动建表后回填）
DUTY_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
BITABLE_DUTY_TABLE_ID=tblxxxxxxxxxxxxxx

# 表字段名映射（默认即计划字段名，手动建表字段不同时在此改）
DUTY_FIELD_USER=人员
DUTY_FIELD_NAME=姓名
DUTY_FIELD_DATE=日期
DUTY_FIELD_POSITION=岗位
DUTY_FIELD_STATUS=完成状态
DUTY_FIELD_DAY_STATUS=当日总状态
DUTY_FIELD_RECEIPT_LEADER=凭证-负责
DUTY_FIELD_RECEIPT_WORKSTATION=凭证-工位
DUTY_FIELD_RECEIPT_ASSEMBLY=凭证-装配

# 定时任务（node-cron 表达式，Asia/Shanghai；均过晚间静默闸门）
# 次日提醒（D-1 20:00 私信明日值日队员）
DUTY_PREV_REMIND_SCHEDULE=0 0 20 * * *
# 值日周预告（D-7 20:05 私信一周后的当日值日队员，v36 起新增）
DUTY_WEEK_REMIND_SCHEDULE=0 5 20 * * *
# 当日询问（D 日 18:30 私信询问，开启监听窗口）
DUTY_ASK_SCHEDULE=0 30 18 * * *
DUTY_LASTCALL_SCHEDULE=0 0 23 * * *
# 收口（D 日 24:00/次日 0 点：未回复置未做完、算当日总状态、生成补偿插入；写表动作不延迟，仅通知过闸门；
# 0 点已跨日，收口归属日期由程序自动回退到值日当天）
DUTY_DEADLINE_SCHEDULE=0 0 0 * * *
# 对账（每日 00:30：重算昨日总状态、核对补偿插入义务）
DUTY_RECONCILE_SCHEDULE=0 30 0 * * *
# 看板自动播报（每日 12:00：经群自定义机器人 webhook 推今日值日看板，过静默闸门）
DUTY_BOARD_BROADCAST_SCHEDULE=0 0 12 * * *

# 排班生成
# 每次生成跨度（自然日历月数）
DUTY_GENERATE_MONTHS=1
# 同一人两次值日最小间隔（软约束，人少时自动放宽）
DUTY_MIN_INTERVAL_DAYS=2

# 排班生成权限（逗号分隔 open_id，可选覆盖；默认取名册里 admin:true 的成员）
DUTY_ADMIN_OPEN_IDS=

# 群看板限流（分钟，每群限流一次）
DUTY_BOARD_RATE_LIMIT_MINUTES=60

# 今日值日看板发送通道：群自定义机器人 webhook（非对话型 im API）
# 留空 = 回退应用身份 im API 直发（旧行为）；webhook 等同群凭据，真值只落 .env
DUTY_BOARD_WEBHOOK_URL=
# webhook 开启签名校验时填密钥，未开启留空
DUTY_BOARD_WEBHOOK_SECRET=

# 运行时状态文件（SFTP 部署会清空 /c/qianli/opt/duty-bot，生产必须放项目目录之外；
# 部署目标为 Windows 小电脑——路径要带盘符，POSIX 形式会被解析到当前盘根）
DUTY_STATE_FILE=C:/home/qianli/duty-bot-data/duty-state.json

# 晚间静默（播报时段限制，[START,END) Asia/Shanghai；QUIET_HOURS_DISABLED=1 关闭）
QUIET_HOURS_START=2
QUIET_HOURS_END=9
# QUIET_HOURS_DISABLED=1
# 静默积压文件（同 DUTY_STATE_FILE，放项目目录之外，带盘符）
QUIET_BACKLOG_FILE=C:/home/qianli/duty-bot-data/quiet-backlog.json

# hub 服务地址（18:30 询问的 DDL 冲突提示消费 GET /api/ddl/pending；失联静默降级不加提示）
HUB_SERVICE_URL=http://localhost:3000

# ---------------- 值日域管辖策略（权限管辖范畴/生效范畴，单一事实来源） ----------------
# 值日专用群（快递申领群等，逗号分隔 chat_id）：hub 经 GET /api/duty/policy 消费，
# 群内闸门（看板触发词/关键词回答/基础指令关闭/引导语）以此为准；留空 = 不限制
DUTY_GROUP_CHAT_IDS=

# ---------------- 部署配置（push.js 用，严禁提交；NAS_ 为历史命名，语义=部署目标=小电脑 DESKTOP-FE1MIGI） ----------------
NAS_HOST=192.168.31.57
NAS_PORT=22
NAS_USER=mechax
NAS_PASSWORD=xxxxxxxx

# ---------------- 动态广场事件流（机器人项目看板「动态广场」表；表 id 可用 env 覆盖，默认值已内置 config） ----------------
# 动态广场事件流开关（2026-09-20 拍板：广场由用户自维护，机器人默认停写；设 1 才恢复机器人写入）
# PLAZA_ENABLED=0
# PLAZA_BITABLE_APP_TOKEN=ZlVZbXDkRayUzSsFRiycznmZn5b
# PLAZA_BITABLE_TABLE_ID=tbld1zHXkTzko20p

# ---------------- 快递助手（快递申领群专属，2026-09-17） ----------------
# 群清单留空 = 回落 DUTY_GROUP_CHAT_IDS；表 id 默认已内置 config（「机器人项目看板」base 的「快递」表）
# EXPRESS_GROUP_CHAT_IDS=
# EXPRESS_WINDOW_MINUTES=5
# EXPRESS_BROADCAST_SCHEDULE=0 0 * * * *
# EXPRESS_TABLE_ID=tblhQuGY9ZdqDSpc
# EXPRESS_ENABLED=0

# 管理端点鉴权（2026-09-13，全局共享值）：写端点需 X-API-Token 头；未配置 = 写端点锁定
# 生成：openssl rand -hex 24（全工作区共享同一值，运维台代理自动带头）
API_TOKEN=

# 每周补偿/加罚非请假位插入容量（超出自动顺延下一周，防欠账集中安置超员；默认 2）
#DUTY_WEEKLY_INSERTION_ALLOWANCE=2
